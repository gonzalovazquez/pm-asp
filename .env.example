# ============================================================
# Agentic Skills Platform (PM ASP) — POC environment
# Copy to .env and fill in secrets:  cp .env.example .env
# ============================================================

# ---- LLM (via agentgateway) --------------------------------
# Required for REAL mode. agentgateway injects this upstream to Anthropic;
# the backend and n8n never see the key directly.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model ids (public Anthropic API ids, routed through agentgateway).
ROUTER_MODEL=claude-haiku-4-5-20251001
PRD_MODEL=claude-sonnet-5

# ---- agentgateway ------------------------------------------
# agentgateway v1.3.1 serves the LLM (Anthropic /v1/messages) on :4000 and the
# MCP endpoint on :3000. Backend + n8n LLM calls use the :4000 URL below; the MCP
# node (M4 seam) would use http://agentgateway:3000/mcp.
AGENTGATEWAY_URL=http://agentgateway:4000

# ---- Self-hosted MCP servers (run on YOUR machine) ---------
# Per decision #3: self-hosted Atlassian (Jira+Confluence, Data Center, PAT auth)
# and GitHub MCP servers. They run on your host, NOT in this compose file.
# agentgateway reaches them via host.docker.internal — set ports to match yours.
# The PAT lives with each MCP server's own config, not here.
ATLASSIAN_MCP_URL=http://host.docker.internal:9000/mcp/
GITHUB_MCP_URL=http://host.docker.internal:9001/mcp/

# ---- Postgres ----------------------------------------------
POSTGRES_USER=asp
POSTGRES_PASSWORD=asp_dev_pw
POSTGRES_DB=asp
# DSN the backend uses (host = compose service name "postgres").
DATABASE_URL=postgresql://asp:asp_dev_pw@postgres:5432/asp

# ---- Redis -------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- n8n ---------------------------------------------------
N8N_URL=http://n8n:5678
# Must be identical for the n8n container and the one-shot importer so they
# share the same encrypted store. Change for anything beyond a local POC.
N8N_ENCRYPTION_KEY=poc-only-change-me-please-32chars+
GENERIC_TIMEZONE=UTC

# ---- Backend behavior --------------------------------------
# 1 → OFFLINE dev mode: Level-1 keyword router + canned PRD. No secrets/MCP needed.
# 0 → REAL mode: LLM router + n8n workflows calling Claude + MCP via agentgateway.
OFFLINE_MODE=1

# ---- Frontend ----------------------------------------------
# Browser-facing base URL of the backend (host port, not the compose network).
NEXT_PUBLIC_API_BASE=http://localhost:8000
